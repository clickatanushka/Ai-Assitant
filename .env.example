# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Vector — create a DENSE index:
#   Embedding Model: Custom   Dimensions: 1536   Metric: COSINE
# (vectors are computed here with gemini-embedding-2; Upstash will not mix a
#  Custom dense model with its hosted BM25, so the index is dense-only)
# https://console.upstash.com/vector
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Password required to upload or delete documents. Asking questions is open.
ADMIN_PASSWORD=

# Optional: only needed to store the original PDFs for in-app preview.
BLOB_READ_WRITE_TOKEN=
