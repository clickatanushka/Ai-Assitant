# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Vector — create a HYBRID index:
#   Dense model:  BAAI/bge-m3      (multilingual, 1024 dims — same model as before)
#   Sparse model: BM25
# https://console.upstash.com/vector
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis (document store) — https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password required to upload or delete documents. Asking questions is open.
ADMIN_PASSWORD=

# Optional: only needed to store the original PDFs for in-app preview.
BLOB_READ_WRITE_TOKEN=
